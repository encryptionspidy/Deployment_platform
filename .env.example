# ==============================================================================
# Deploy Platform — Environment Variables Template (.env.example)
# ==============================================================================
# Copy relevant sections to each service's .env file and fill in real values.
# NEVER commit real secrets. This file only contains safe placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dashboard Backend  →  services/dashboard-backend/.env
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers -> OAuth Apps
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:8002/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Long random string for signing session cookies
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_64_char_random_hex_string

# Fernet symmetric key for encrypting GitHub access tokens at rest in PostgreSQL
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_a_fernet_key_here

# Webhook & database
WEBHOOK_TARGET_URL=http://localhost:8000/webhook/github
GITHUB_WEBHOOK_SECRET=change_me_to_a_random_secret_shared_with_github
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform
REDIS_HOST=localhost
REDIS_PORT=6379
PROMETHEUS_URL=http://localhost:9090

# Set to true ONLY in development to enable the /auth/demo-login bypass
ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# 2. Build Worker  →  services/build-worker/.env
# ------------------------------------------------------------------------------
# Must match dashboard-backend ENCRYPTION_KEY exactly (used to decrypt tokens)
ENCRYPTION_KEY=generate_a_fernet_key_here
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform
REDIS_HOST=localhost
REDIS_PORT=6379
# Max seconds for a docker build before it is forcibly aborted (default: 300)
BUILD_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 3. Webhook Receiver  →  services/webhook-receiver/.env
# ------------------------------------------------------------------------------
# Must match the secret configured in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=change_me_to_a_random_secret_shared_with_github
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Metrics Exporter  →  services/metrics-exporter/.env
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform

# ------------------------------------------------------------------------------
# 5. Frontend  →  frontend/.env.local
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8002
