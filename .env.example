# ==============================================================================
# Deploy Platform — Environment Variables Example (.env.example)
# ==============================================================================
# Copy the relevant sections to the respective services' .env files:
# - services/webhook-receiver/.env
# - services/build-worker/.env
# - services/dashboard-backend/.env
# - frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dashboard Backend Service (services/dashboard-backend/.env)
# ------------------------------------------------------------------------------
# GitHub OAuth App credentials (create under GitHub -> Settings -> Developer Settings -> OAuth Apps)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8002/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Session secret used for signing cookie sessions in FastAPI
SESSION_SECRET=deploy_platform_secure_session_secret_change_me_in_prod

# Fernet symmetric encryption key for encrypting user access tokens at rest in PostgreSQL
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=JvPPQta6LlI-6UymvHBhQdqNM8N3yIIeo0F9T_6_vIo=

# Webhook destination URL configured on user repositories when connected via Dashboard
WEBHOOK_TARGET_URL=http://localhost:8000/webhook/github
GITHUB_WEBHOOK_SECRET=my-permanent-secret-123

# Database & Redis Connection URLs
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. Build Worker Service (services/build-worker/.env)
# ------------------------------------------------------------------------------
# Same Fernet encryption key used by dashboard-backend to decrypt stored GitHub tokens
ENCRYPTION_KEY=JvPPQta6LlI-6UymvHBhQdqNM8N3yIIeo0F9T_6_vIo=
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Webhook Receiver Service (services/webhook-receiver/.env)
# ------------------------------------------------------------------------------
# Shared secret used to verify HMAC-SHA256 signatures from GitHub webhooks
GITHUB_WEBHOOK_SECRET=my-permanent-secret-123
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Metrics Exporter Service (services/metrics-exporter/.env)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://devops:devops123@localhost:5433/deploy_platform

# ------------------------------------------------------------------------------
# 5. Frontend UI (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8002
